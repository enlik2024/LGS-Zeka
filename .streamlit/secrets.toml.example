# LGS-Zeka Secrets Configuration Template
# Bu dosyayı 'secrets.toml' olarak kopyalayın ve gerçek değerlerinizi girin
# UYARI: secrets.toml dosyasını asla Git'e eklemeyin!

# =============================================================================
# GOOGLE SHEETS API CREDENTIALS
# =============================================================================
# Google Cloud Console'dan Service Account oluşturup JSON key indirin
# İndirdiğiniz JSON dosyasının içeriğini buraya yapıştırın

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR-PRIVATE-KEY-HERE\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project.iam.gserviceaccount.com"
client_id = "your-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com"

# Google Sheets Spreadsheet Key (URL'deki ID kısmı)
# Örnek URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_KEY_BURASI/edit
spreadsheet_key = "your-spreadsheet-key-here"

# =============================================================================
# GEMINI AI API
# =============================================================================
# Google AI Studio'dan API key alın: https://makersuite.google.com/app/apikey

[gemini]
# Birincil API key
api_key = "your-gemini-api-key-here"

# İkincil API key (fallback - kota aşılırsa otomatik geçiş yapar)
api_key_secondary = "your-secondary-api-key-here"

# Model tercihleri (artık config/app_config.yaml'dan yönetiliyor)
# Aşağıdaki ayarlar legacy destek içindir
default_model = "gemini-2.5-flash"
pro_model = "gemini-2.5-flash"

# =============================================================================
# PERPLEXITY API (Beta Modu - Critic)
# =============================================================================
# Perplexity API key alın: https://www.perplexity.ai/settings/api

[perplexity]
api_key = "pplx-your-perplexity-api-key-here"


# =============================================================================
# SUPABASE (Production Database)
# =============================================================================
# Supabase Dashboard'dan Project URL ve API Key alın

SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-supabase-anon-key"

# =============================================================================
# UYGULAMA AYARLARI
# =============================================================================

[app]
# Veritabanı tipi: "google_sheets" veya "supabase"
database_type = "google_sheets"

# Öğrenci kimlik doğrulama (opsiyonel)
enable_auth = false

# Debug modu
debug_mode = false

# =============================================================================
# LGS PUAN HESAPLAMA SABİTLERİ
# =============================================================================

[lgs_constants]
# Ders katsayıları
turkce_katsayi = 4
matematik_katsayi = 4
fen_katsayi = 4
inkilap_katsayi = 1
din_katsayi = 1
dil_katsayi = 1

# Standart sapma ve ortalama değerleri (örnek değerler)
# Gerçek değerler MEB verilerine göre güncellenmelidir
turkce_ortalama = 50.0
turkce_std = 15.0
matematik_ortalama = 45.0
matematik_std = 18.0
fen_ortalama = 48.0
fen_std = 16.0
inkilap_ortalama = 55.0
inkilap_std = 12.0
din_ortalama = 52.0
din_std = 13.0
dil_ortalama = 50.0
dil_std = 14.0
